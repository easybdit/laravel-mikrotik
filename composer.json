{
    "name": "easybdit/laravel-mikrotik",
    "description": "A Laravel abstraction for MikroTik RouterOS devices: connection management, router resource and hardware-health retrieval over the RouterOS REST API.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/easybdit/laravel-mikrotik",
    "authors": [
        {
            "name": "Md Murad Hosen",
            "email": "muradbd.info@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/easybdit/laravel-mikrotik/issues",
        "source": "https://github.com/easybdit/laravel-mikrotik"
    },
    "keywords": ["laravel", "mikrotik", "routeros", "network", "monitoring"],
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Easybdit\\LaravelMikrotik\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Easybdit\\LaravelMikrotik\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Easybdit\\LaravelMikrotik\\MikrotikServiceProvider"
            ],
            "aliases": {
                "Mikrotik": "Easybdit\\LaravelMikrotik\\Facades\\Mikrotik"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
